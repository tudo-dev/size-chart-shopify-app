    "login:live": "node scripts/verify-login-live.mjs"
  },
  "dependencies": {
    "@nuxt/eslint": "1.5.1",
    "@nuxt/kit": "4.0.2",
    "@ownego/polaris-vue": "2.1.31",
    "@shopify/polaris-icons": "9.3.1",
    "@shopify/shopify-api": "13.1.0",
    "@types/node": "24.1.0",
    "better-sqlite3": "11.10.0",
    "dotenv": "17.2.1",
    "drizzle-kit": "0.26.2",
    "drizzle-orm": "0.35.3",
    "eslint": "9.30.1",
    "h3": "1.15.11",
    "nuxt": "3.17.6",
    "nuxt-security": "2.2.0",
    "p-limit": "5.0.0",
    "tsx": "4.21.0",
    "typescript": "5.8.3",
    "vue": "3.5.17",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13"
  }
