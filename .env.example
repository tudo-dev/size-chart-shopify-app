# Shopify app credentials for Tudoholic Size Charts.
# Fill with `shopify app env pull` (writes .env), or copy from the app's page
# in the Shopify developer dashboard. The secret NEVER goes into git or chat.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# The app's public address. `shopify app dev` sets it on a laptop.
SHOPIFY_APP_URL=https://sizecharts.tudoholic.com

# Production only: where the database file lives inside the container.
# docker-compose sets this; leave it empty on a laptop.
DATABASE_URL=
