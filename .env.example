# Shopify app credentials for Tudoholic Size Charts.
# Fill with `shopify app env pull` (writes .env), or copy from the app's page
# in the Shopify developer dashboard. The secret NEVER goes into git or chat.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# The app's public address. `shopify app dev` sets it on a laptop.
SHOPIFY_APP_URL=https://sizecharts.tudoholic.com

# The stores allowed to use the app: myshopify domains, comma-separated.
# REQUIRED on the server — left empty there, nobody can log in. On a laptop
# (`shopify app dev`) empty means any store, so the test store works.
ALLOWED_SHOPS=tudoholic-com.myshopify.com

# Production only: where the database file lives inside the container.
# docker-compose sets this; leave it empty on a laptop.
DATABASE_URL=

# Reading the Chinese size-chart pictures (Claude). The key goes ONLY into the
# server's .env — never into git, never into chat. Without it the app still
# fetches pictures and shows them; the Read button explains what is missing.
ANTHROPIC_API_KEY=
# Optional; the default is the model the reader was tested with.
SIZE_CHART_READER_MODEL=
