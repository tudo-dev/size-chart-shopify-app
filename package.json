{
  "name": "size-chart-shopify-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "build": "nuxt build",
    "dev": "shopify app dev",
    "dev:app": "nuxt dev",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "db:generate": "drizzle-kit generate",
    "verify": "tsx scripts/verify-skeleton.ts && tsx scripts/verify-size-charts.ts",
